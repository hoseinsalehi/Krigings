// Daily precipitation, two-part method at points (e.g. HRU centroids), CSV output
// Run: ./run_oms.sh simulation/advanced/krig_precip_twopart_points.sim   (oms3.CLI -r, as the OMS console)
import static oms3.SimBuilder.instance as OMS3
def home = oms_prj

OMS3.sim {
    resource "$home/lib"
    model {
        components { "krig" "pokriging.PoKriging" }
        parameter {
            "krig.variable"         "precip"
            "krig.stationsFile"     "$home/data/stations_precip.csv"
            "krig.dataFile"         "$home/data/data_precip.csv"
            "krig.missingValue"     ""
            "krig.mode"             "interpolation"
            "krig.target"           "points"
            "krig.pointsFile"       "$home/data/points_reference.csv"
            "krig.crs"              "EPSG:3035"
            "krig.demFile"          "$home/data/dem_po_1km.asc"
            "krig.gridCellsFile"    "$home/data/grid_cells.csv"
            "krig.precipMethod"     "twopart"
            "krig.periodStart"      "1991-01-01"
            "krig.periodEnd"        "2020-12-31"
            "krig.normalsDir"       "$home/output/normals_java"
            "krig.outputFormat"     "csv"
            "krig.threads"          12
            "krig.outputDir"        "$home/output/krig_precip_twopart_points"
        }
    }
}
