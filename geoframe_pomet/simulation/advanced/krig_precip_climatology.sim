// Daily precipitation, climatology/ratio method: 1 km grid + station LOO, 1991-2020
// Run: ./run_oms.sh simulation/advanced/krig_precip_climatology.sim   (oms3.CLI -r, as the OMS console)
import static oms3.SimBuilder.instance as OMS3
def home = oms_prj

OMS3.sim {
    resource "$home/lib"
    model {
        components { "krig" "pokriging.PoKriging" }
        parameter {
            "krig.variable"         "precip"
            "krig.stationsFile"     "$home/data/stations_precip.csv"
            "krig.dataFile"         "$home/data/data_precip.csv"
            "krig.missingValue"     ""
            "krig.mode"             "both"
            "krig.target"           "grid"
            "krig.crs"              "EPSG:3035"
            "krig.demFile"          "$home/data/dem_po_1km.asc"
            "krig.gridCellsFile"    "$home/data/grid_cells.csv"
            "krig.precipMethod"     "climatology"
            "krig.periodStart"      "1991-01-01"
            "krig.periodEnd"        "2020-12-31"
            "krig.normalsDir"       "$home/output/normals_java"
            "krig.outputFormat"     "netcdf"
            "krig.quantise"         true
            "krig.diagnostics"      true
            "krig.threads"          12
            "krig.outputDir"        "$home/output/krig_precip_climatology"
        }
    }
}
