// Equivalence test vs reference/daily/precip_direct (10 dates of 2020, 8192 cells, Python normals)
// Run: ./run_oms.sh simulation/tests/eq_precip_direct.sim   (oms3.CLI -r, as the OMS console)
import static oms3.SimBuilder.instance as OMS3
def home = oms_prj

OMS3.sim {
    resource "$home/lib"
    model {
        components { "krig" "pokriging.PoKriging" }
        parameter {
            "krig.variable"           "precip"
            "krig.stationsFile"       "$home/data/stations_precip.csv"
            "krig.dataFile"           "$home/data/data_precip.csv"
            "krig.missingValue"       ""
            "krig.mode"               "both"
            "krig.target"             "grid"
            "krig.crs"                "EPSG:3035"
            "krig.demFile"            "$home/data/dem_po_1km.asc"
            "krig.gridCellsFile"      "$home/data/grid_cells.csv"
            "krig.targetCellsFile"    "$home/tests/eq/target_cells.csv"
            "krig.datesFile"          "$home/tests/eq/dates_reference.csv"
            "krig.periodStart"        "2020-01-01"
            "krig.periodEnd"          "2020-12-31"
            "krig.normalsDir"         "$home/reference_run/normals_rebuild/normals"
            "krig.outputFormat"       "csv"
            "krig.quantise"           false
            "krig.threads"            10
            "krig.precipMethod"       "direct"
            "krig.outputDir"          "$home/output/eq_oms/precip_direct"
        }
    }
}
